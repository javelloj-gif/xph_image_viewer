// ============================================================================
// app.rc — Windows Resource Script
// LenteUV Image Viewer — Native C++20
// ============================================================================

#include <winresrc.h>

// ─── Application Icon ─────────────────────────────────────────────────────────
1 ICON "lenteuv.ico"

// ─── Application Manifest ────────────────────────────────────────────────────
// Note: The manifest is embedded via CMake's LINK_FLAGS instead of via RC.
// This avoids "duplicate resource" errors with MSVC's auto-manifest linking.

// ─── Version Information ─────────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,00,3,0
    PRODUCTVERSION 1,00,3,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // English (US), Unicode
        BEGIN
            VALUE "CompanyName",      "xPhang"
            VALUE "FileDescription",  "LenteUV Image Viewer"
            VALUE "FileVersion",      "1.00.3.0"
            VALUE "InternalName",     "lenteuv"
            VALUE "LegalCopyright",   "Copyright (C) 2026 xPhang. LenteUV is a fork of Sergkruma's image viewer by Sergei Krumas (github.com/sergkrumas)."
            VALUE "OriginalFilename", "lenteuv.exe"
            VALUE "ProductName",      "LenteUV"
            VALUE "ProductVersion",   "1.00.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0  // English (US), Unicode
    END
END
